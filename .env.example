# Local MongoDB from docker compose, or a private MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=kundeeeq
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Vercel detects its own proxy. For other hosts with exactly one trusted HTTPS proxy, set TRUST_PROXY=1.
TRUST_PROXY=0
